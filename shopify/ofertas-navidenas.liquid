{% comment %}
  GLEE · Sección "Ofertas navideñas"
  Dónde va: Personalizar → Página de inicio → Agregar sección → "Liquid personalizado" → pegar todo esto.

  ===== Ajustes (cambia solo lo que está entre comillas) =====
{% endcomment %}
{% assign gof_coleccion = 'ofertas-navidenas' %}   {% comment %} "handle" de la colección: lo último de su enlace, /collections/ESTO {% endcomment %}
{% assign gof_titulo    = 'Ofertas navideñas' %}
{% assign gof_subtitulo = 'Precios especiales por tiempo limitado' %}
{% assign gof_boton     = 'Ver todas las ofertas' %}
{% assign gof_maximo    = 8 %}                      {% comment %} cuántos productos mostrar {% endcomment %}
{% assign gof_termina   = '2026-12-24T23:59:59-06:00' %} {% comment %} cuándo terminan (para el contador). Déjalo vacío '' para quitar el contador {% endcomment %}

{% assign gof_col = collections[gof_coleccion] %}
{% if gof_col.products.size > 0 %}
{% assign gof_tope = 0 %}
{% for product in gof_col.products limit: gof_maximo %}
  {% if product.available and product.compare_at_price > product.price %}
    {% assign gof_a = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
    {% if gof_a > gof_tope %}{% assign gof_tope = gof_a %}{% endif %}
  {% endif %}
{% endfor %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400&display=swap" rel="stylesheet">

<style>
  .gof { --oro: #e2bd62; --oro2: #b98a35; --crema: #f3e9d6; --vino: #8c2236; --gap: clamp(12px, 1.8vw, 24px);
    position: relative; overflow: hidden; padding: clamp(46px, 7vw, 86px) 0 clamp(40px, 6vw, 72px); color: var(--crema);
    background: radial-gradient(circle at 84% 8%, rgba(255,244,220,.16) 0%, rgba(255,244,220,0) 34%), linear-gradient(180deg, #0f1f36 0%, #0c182b 55%, #08111e 100%); }
  .gof * { box-sizing: border-box; }
  .gof-in-wrap { position: relative; z-index: 2; max-width: 1320px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }

  /* encabezado */
  .gof-head { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; margin-bottom: clamp(24px, 4vw, 44px); }
  .gof-eyebrow { margin: 0; font-size: 11px; letter-spacing: .34em; padding-left: .34em; text-transform: uppercase; color: var(--oro); display: flex; align-items: center; gap: 12px; }
  .gof-eyebrow::before, .gof-eyebrow::after { content: ''; width: clamp(20px, 5vw, 54px); height: 1px; background: linear-gradient(90deg, rgba(226,189,98,0), var(--oro)); }
  .gof-eyebrow::after { transform: scaleX(-1); }
  .gof-title { margin: 0; font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-weight: 900; letter-spacing: -.01em; line-height: 1.12;
    font-size: clamp(34px, 6.4vw, 68px); padding-bottom: .08em; color: transparent; -webkit-background-clip: text; background-clip: text;
    background-image: linear-gradient(105deg, rgba(255,255,255,0) 42%, rgba(255,255,255,.95) 50%, rgba(255,255,255,0) 58%),
                      linear-gradient(180deg, #fff6dc 0%, #f2d589 40%, #d6a443 78%, #ad7a25 100%);
    background-size: 300% 100%, 100% 100%; background-position: 100% 0, 0 0; background-repeat: no-repeat; }
  .gof-sub { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: clamp(14px, 2vw, 18px); color: var(--crema); opacity: .85; }

  /* muñeco de nieve con el letrero: saluda, parpadea, sigue con los ojos y reacciona al tocarlo */
  .gof-man { position: relative; display: block; width: clamp(200px, 30vw, 270px); margin: 0 auto 2px; padding: 0; border: 0; background: none; color: inherit; font: inherit;
    cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .gof-man svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gof-man:focus-visible { outline: 2px solid var(--oro); outline-offset: 6px; border-radius: 8px; }
  .gof-m-jump, .gof-m-all, .gof-m-arm, .gof-m-lids, .gof-m-hat, .gof-m-tail, .gof-m-sign, .gof-m-board { transform-box: fill-box; }
  .gof-m-jump { transform-origin: 50% 100%; }
  .gof-m-all  { transform-origin: 50% 100%; animation: gofBreath 3.2s ease-in-out infinite; }
  .gof-m-arm  { transform-origin: 100% 100%; animation: gofWave 5s ease-in-out infinite; }
  .gof-m-eyes { transition: transform .18s ease-out; }
  .gof-m-lids { transform-origin: 50% 50%; animation: gofBlink 4.6s infinite; }
  .gof-m-hat  { transform-origin: 20% 100%; transition: transform .35s cubic-bezier(.3,1.6,.5,1); }
  .gof-m-tail { transform-origin: 0 0; animation: gofFlutter 2.4s ease-in-out infinite alternate; }
  .gof-m-sign { transform-origin: 50% 100%; animation: gofSway 3.8s ease-in-out infinite alternate; }
  .gof-m-board { transform-origin: 50% 50%; transition: transform .26s ease-in; }
  .gof-m-board.gof-flip { transform: scaleX(0); }
  .gof-man.gof-hi .gof-m-jump { animation: gofJump .75s cubic-bezier(.3,.6,.4,1); }
  .gof-man.gof-hi .gof-m-hat { transform: translateY(-9px) rotate(-16deg); }
  .gof-man.gof-hi .gof-m-arm { animation: gofWaveFast .75s ease-in-out; }
  .gof-hint { position: absolute; left: 0; top: 4%; font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 13px; color: var(--oro);
    transform: rotate(-8deg); transition: opacity .4s ease; animation: gofHint 2.2s ease-in-out infinite; }
  .gof-man.gof-tocado .gof-hint { opacity: 0; animation: none; }
  .gof-ball { position: absolute; left: 0; top: 0; z-index: 3; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, #fff 0 45%, rgba(255,255,255,.7) 60%, rgba(255,255,255,0) 76%); }

  /* contador */
  .gof-count { display: flex; gap: clamp(8px, 1.4vw, 14px); margin-top: 8px; }
  .gof-count div { min-width: clamp(56px, 9vw, 76px); padding: 9px 6px 7px; border: 1px solid rgba(226,189,98,.45); border-radius: 3px; background: rgba(255,255,255,.04); }
  .gof-count b { display: block; font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-size: clamp(22px, 3.4vw, 32px); line-height: 1; color: #fff6dc; font-variant-numeric: tabular-nums; }
  .gof-count span { display: block; margin-top: 5px; font-size: 9.5px; letter-spacing: .2em; padding-left: .2em; text-transform: uppercase; color: var(--oro); }

  /* productos */
  .gof-rail { position: relative; }
  .gof-track { display: flex; gap: var(--gap); margin: 0; padding: 6px 0 14px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .gof-track::-webkit-scrollbar { display: none; }
  .gof-track > li { flex: 0 0 62%; scroll-snap-align: start; min-width: 0; }
  @media (min-width: 640px)  { .gof-track > li { flex-basis: calc((100% - var(--gap) * 2) / 3); } }
  @media (min-width: 1000px) { .gof-track > li { flex-basis: calc((100% - var(--gap) * 3) / 4); } }
  .gof-card { display: block; color: inherit; text-decoration: none; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  .gof-img { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 3px; background: #1a2c4c; }
  .gof-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  .gof-img::after { content: ''; position: absolute; inset: 0; pointer-events: none; transform: translateX(-130%);
    background: linear-gradient(105deg, rgba(255,255,255,0) 35%, rgba(255,255,255,.38) 50%, rgba(255,255,255,0) 65%); }
  .gof-badge { position: absolute; left: 10px; top: 10px; z-index: 1; padding: 5px 10px 4px; border-radius: 999px; background: var(--vino); color: #f6dfae;
    font-size: 12px; font-weight: 600; letter-spacing: .04em; line-height: 1; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
  .gof-badge.gof-out { background: rgba(8,17,30,.78); color: var(--crema); }
  .gof-name { position: relative; margin: 14px 0 0; padding-bottom: 8px; font-size: 14px; font-weight: 400; line-height: 1.35; letter-spacing: .02em; color: var(--crema);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .gof-name::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px; background: var(--oro); transform: scaleX(0); transform-origin: 0 50%; transition: transform .5s ease; }
  .gof-price { margin: 8px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 15px; }
  .gof-now { color: var(--oro); font-weight: 600; letter-spacing: .02em; }
  .gof-price s { color: rgba(243,233,214,.55); font-size: 13px; }
  @media (hover: hover) {
    .gof-card:hover { transform: translateY(-5px); }
    .gof-card:hover .gof-img img { transform: scale(1.06); }
    .gof-card:hover .gof-name::after { transform: scaleX(1); }
  }
  .gof-card:focus-visible { outline: 2px solid var(--oro); outline-offset: 4px; }

  /* flechas (solo compu) */
  .gof-arrow { display: none; position: absolute; top: 36%; z-index: 3; width: 44px; height: 44px; padding: 0; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(226,189,98,.7); background: rgba(8,17,30,.72); color: var(--oro); transition: background .3s ease, color .3s ease, opacity .3s ease; }
  .gof-arrow svg { display: block; width: 18px; height: 18px; margin: auto; }
  .gof-arrow:hover { background: var(--oro); color: #0c182b; }
  .gof-arrow[disabled] { opacity: 0; pointer-events: none; }
  .gof-arrow.gof-prev { left: -14px; }
  .gof-arrow.gof-next { right: -14px; }
  @media (hover: hover) and (min-width: 640px) { .gof-arrow { display: block; } }

  /* botón */
  .gof-foot { display: flex; justify-content: center; margin-top: clamp(20px, 3vw, 34px); }
  .gof-btn { position: relative; overflow: hidden; display: inline-block; padding: 15px 34px; border: 1px solid var(--oro); color: var(--oro); text-decoration: none;
    font-size: 12px; letter-spacing: .24em; padding-left: calc(34px + .24em); text-transform: uppercase; transition: color .4s ease; }
  .gof-btn::before { content: ''; position: absolute; inset: 0; background: var(--oro); transform: scaleX(0); transform-origin: 0 50%; transition: transform .45s cubic-bezier(.6,0,.2,1); }
  .gof-btn span { position: relative; }
  .gof-btn:hover, .gof-btn:focus-visible { color: #0c182b; }
  .gof-btn:hover::before, .gof-btn:focus-visible::before { transform: scaleX(1); }

  /* serie de luces arriba + nieve */
  .gof-lights { position: absolute; left: 0; right: 0; top: 0; z-index: 1; pointer-events: none; }
  .gof-lights svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gof-lb { position: absolute; width: var(--bs, 9px); margin-left: calc(var(--bs, 9px) / -2); opacity: .22; }
  .gof-lb i { display: block; width: 46%; height: 3px; margin: 0 auto; border-radius: 1px 1px 0 0; background: #2a3550; }
  .gof-lb b { position: relative; display: block; width: 100%; aspect-ratio: 1 / 1.35; border-radius: 50% 50% 50% 50% / 42% 42% 58% 58%;
    background: radial-gradient(circle at 38% 32%, #fff 0 12%, var(--c1) 42%, var(--c2) 100%); }
  .gof-lb b::after { content: ''; position: absolute; inset: -110%; border-radius: 50%; background: radial-gradient(circle, var(--glow) 0%, rgba(255,255,255,0) 62%); opacity: 0; }
  .gof-snow { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .gof-snow i { position: absolute; top: -4%; width: var(--s); aspect-ratio: 1; border-radius: 50%; opacity: var(--o);
    background: radial-gradient(circle, #fff 0 36%, rgba(255,255,255,.7) 52%, rgba(255,255,255,0) 72%);
    animation: gofFall var(--d) linear var(--dl) infinite; }
  .gof-off .gof-snow i, .gof-off .gof-lb b::after { animation-play-state: paused !important; }

  /* ===== animación de entrada (solo si hay JavaScript; sin él todo se ve normal) ===== */
  .gof-js .gof-eyebrow, .gof-js .gof-sub, .gof-js .gof-count, .gof-js .gof-foot { opacity: 0; transform: translateY(14px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.8,.2,1); }
  .gof-js .gof-man { opacity: 0; transform: translateY(46px) scale(.8); transition: opacity .5s ease, transform .9s cubic-bezier(.3,1.5,.5,1); }
  .gof-js.gof-in .gof-man { opacity: 1; transform: none; }
  .gof-js .gof-title { opacity: 0; transform: translateY(22px) scale(.97); transition: opacity .8s ease, transform .9s cubic-bezier(.2,.8,.2,1); }
  .gof-js .gof-track > li { opacity: 0; transform: translateY(34px); transition: opacity .7s ease, transform .9s cubic-bezier(.2,.8,.2,1); transition-delay: calc(var(--i) * 90ms + .7s); }
  .gof-js .gof-badge { transform: scale(0); transition: transform .5s cubic-bezier(.3,1.6,.5,1); transition-delay: calc(var(--i) * 90ms + 1.25s); }
  .gof-js.gof-in .gof-eyebrow, .gof-js.gof-in .gof-sub, .gof-js.gof-in .gof-count, .gof-js.gof-in .gof-foot,
  .gof-js.gof-in .gof-title, .gof-js.gof-in .gof-track > li { opacity: 1; transform: none; }
  .gof-js.gof-in .gof-badge { transform: none; }
  .gof-js.gof-in .gof-eyebrow { transition-delay: .3s; }
  .gof-js.gof-in .gof-title { transition-delay: .4s; animation: gofShine 1.3s ease-in-out 1s forwards; }
  .gof-js.gof-in .gof-sub { transition-delay: .55s; }
  .gof-js.gof-in .gof-count { transition-delay: .65s; }
  .gof-js.gof-in .gof-foot { transition-delay: 1s; }
  .gof-js.gof-in .gof-img::after { animation: gofSheen 1.1s ease-in-out forwards; animation-delay: calc(var(--i) * 90ms + 1.1s); }
  .gof-js.gof-in .gof-lb { animation: gofOn .45s ease forwards; animation-delay: calc(var(--k) * 38ms + .15s); }
  .gof-js.gof-in .gof-lb b::after { animation: gofGlow var(--d, 2.4s) ease-in-out calc(var(--k) * 38ms + .6s) infinite; }

  @keyframes gofBreath   { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(1.012, .988); } }
  @keyframes gofWave     { 0%, 58%, 100% { transform: rotate(0deg); } 66% { transform: rotate(-17deg); } 74% { transform: rotate(8deg); } 82% { transform: rotate(-14deg); } 90% { transform: rotate(4deg); } }
  @keyframes gofWaveFast { 0%, 100% { transform: rotate(0deg); } 20% { transform: rotate(-22deg); } 40% { transform: rotate(10deg); } 60% { transform: rotate(-20deg); } 80% { transform: rotate(8deg); } }
  @keyframes gofBlink    { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(.1); } }
  @keyframes gofFlutter  { from { transform: rotate(-5deg); } to { transform: rotate(9deg); } }
  @keyframes gofSway     { from { transform: rotate(-1.6deg); } to { transform: rotate(1.6deg); } }
  @keyframes gofJump     { 0%, 100% { transform: none; } 15% { transform: scale(1.06, .92); } 45% { transform: translateY(-16px) scale(.96, 1.05); } 75% { transform: scale(1.05, .94); } }
  @keyframes gofHint     { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
  @keyframes gofShine { to { background-position: 0% 0, 0 0; } }
  @keyframes gofSheen { to { transform: translateX(130%); } }
  @keyframes gofOn    { to { opacity: 1; } }
  @keyframes gofGlow  { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }
  @keyframes gofFall  { from { transform: translate(0, 0); } to { transform: translate(var(--dx, 0px), var(--h, 900px)); } }

  @media (prefers-reduced-motion: reduce) {
    .gof-js .gof-man, .gof-js .gof-eyebrow, .gof-js .gof-sub, .gof-js .gof-count, .gof-js .gof-foot, .gof-js .gof-title, .gof-js .gof-track > li { opacity: 1; transform: none; transition: none; }
    .gof-js .gof-badge { transform: none; transition: none; }
    .gof-snow { display: none; }
    .gof-lb { opacity: 1; }
    .gof *, .gof *::after { animation: none !important; }
  }
</style>

<section class="gof" id="gof" aria-labelledby="gof-titulo">
  <div class="gof-snow" aria-hidden="true"></div>
  <div class="gof-lights" aria-hidden="true"></div>
  <div class="gof-in-wrap">
    <header class="gof-head">
      <button type="button" class="gof-man" aria-label="Muñeco de nieve con el letrero de ofertas. Tócalo para que salude."
              data-msgs="{% if gof_tope > 0 %}HASTA|-{{ gof_tope }}%{% else %}OFERTAS|de Navidad{% endif %};ENVÍOS|a todo el país;POR TIEMPO|limitado">
        <span class="gof-hint" aria-hidden="true">Tócame</span>
        <svg viewBox="0 -10 260 232" aria-hidden="true">
          <defs>
            <radialGradient id="gofsn" cx="38%" cy="30%" r="80%"><stop offset="0" stop-color="#ffffff"/><stop offset=".7" stop-color="#e6eefa"/><stop offset="1" stop-color="#b6c8e4"/></radialGradient>
            <linearGradient id="gofwd" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c08a52"/><stop offset="1" stop-color="#8e5f33"/></linearGradient>
          </defs>
          <g class="gof-m-jump"><g class="gof-m-all">
            <g class="gof-m-sign">
              <path d="M196 96V208" stroke="#7a5230" stroke-width="5" stroke-linecap="round"/>
              <g class="gof-m-board">
                <rect x="140" y="30" width="114" height="68" rx="5" fill="url(#gofwd)" stroke="#6b4526" stroke-width="1.5"/>
                <path d="M141 53H253M141 76H253" stroke="#6b4526" stroke-width=".8" opacity=".45"/>
                <rect x="145.500" y="35.500" width="103" height="57" rx="3" fill="none" stroke="#f3d9a4" stroke-width="1" opacity=".75"/>
                <text class="gof-m-t1" x="197" y="55" text-anchor="middle" font-size="11" letter-spacing="2.5" fill="#fbeee0">HASTA</text>
                <text class="gof-m-t2" x="197" y="85" text-anchor="middle" font-size="30" font-weight="900" fill="#fff6dc" font-family="'Playfair Display', Georgia, serif">-30%</text>
                <path d="M137 34Q139 24 152 27Q160 20 172 26Q184 21 196 27Q210 21 222 27Q236 22 246 28Q257 26 257 34Q250 38 240 35Q228 40 216 35Q204 39 192 35Q178 40 166 35Q152 39 137 34Z" fill="#fff"/>
              </g>
            </g>
            <circle cx="92" cy="166" r="44" fill="url(#gofsn)"/>
            <circle cx="92" cy="104" r="33" fill="url(#gofsn)"/>
            <circle cx="92" cy="98" r="3" fill="#1b2540"/><circle cx="92" cy="112" r="3" fill="#1b2540"/><circle cx="92" cy="126" r="3" fill="#1b2540"/>
            <g class="gof-m-arm"><path d="M63 98 30 68M41 78 29 81M38 75 40 63" fill="none" stroke="#7a5230" stroke-width="3.2" stroke-linecap="round"/></g>
            <path d="M121 100 193 118M172 113 181 104" fill="none" stroke="#7a5230" stroke-width="3.2" stroke-linecap="round"/>
            <circle cx="92" cy="50" r="25" fill="url(#gofsn)"/>
            <g class="gof-m-tail"><path d="M106 78C115 90 113 104 120 113L108 116C103 105 104 93 97 83Z" fill="#8c2236"/><path d="M110 108 119 106" stroke="#e2bd62" stroke-width="1.4"/></g>
            <path d="M65 69Q92 84 119 69L120 80Q92 96 64 80Z" fill="#a9344a"/><path d="M66 74.500Q92 90 119 74.500" fill="none" stroke="#e2bd62" stroke-width="1.3" opacity=".9"/>
            <circle cx="76" cy="57" r="5" fill="#f2a7b0" opacity=".45"/><circle cx="107" cy="59" r="4.5" fill="#f2a7b0" opacity=".4"/>
            <g class="gof-m-eyes"><g class="gof-m-lids">
              <circle cx="83" cy="45" r="3.4" fill="#1b2540"/><circle cx="101" cy="45" r="3.4" fill="#1b2540"/>
              <circle cx="84.200" cy="43.800" r="1" fill="#fff"/><circle cx="102.200" cy="43.800" r="1" fill="#fff"/>
            </g></g>
            <path d="M92 50.500 119 56 92 60.500Z" fill="#e8873a"/>
            <path d="M80 63Q90 71 101 64" fill="none" stroke="#1b2540" stroke-width="1.8" stroke-linecap="round" stroke-dasharray=".1 4.200"/>
            <g class="gof-m-hat">
              <rect x="64" y="24" width="56" height="7" rx="3.500" fill="#6a1425"/><rect x="74" y="-4" width="36" height="30" rx="3" fill="#8c2236"/>
              <rect x="74" y="15" width="36" height="7" fill="#e2bd62"/><path d="M79 0V12" stroke="#b8475a" stroke-width="2.400" stroke-linecap="round" opacity=".7"/>
            </g>
          </g></g>
          <ellipse cx="130" cy="213" rx="128" ry="15" fill="#dfe8f6"/><ellipse cx="112" cy="208" rx="74" ry="6" fill="#fff" opacity=".8"/>
        </svg>
      </button>
      <p class="gof-eyebrow">Navidad en glee</p>
      <h2 class="gof-title" id="gof-titulo">{{ gof_titulo }}</h2>
      {% if gof_subtitulo != blank %}<p class="gof-sub">{{ gof_subtitulo }}</p>{% endif %}
      {% if gof_termina != blank %}
      <div class="gof-count" id="gof-count" data-fin="{{ gof_termina }}" role="timer" aria-label="Tiempo que queda de las ofertas" hidden>
        <div><b data-u="d">00</b><span>días</span></div>
        <div><b data-u="h">00</b><span>horas</span></div>
        <div><b data-u="m">00</b><span>min</span></div>
        <div><b data-u="s">00</b><span>seg</span></div>
      </div>
      {% endif %}
    </header>

    <div class="gof-rail">
      <button type="button" class="gof-arrow gof-prev" aria-label="Productos anteriores" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <ul class="gof-track" id="gof-track">
        {% for product in gof_col.products limit: gof_maximo %}
        <li style="--i:{{ forloop.index0 }}">
          <a class="gof-card" href="{{ product.url | within: gof_col }}">
            <div class="gof-img">
              {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                   sizes="(min-width: 1000px) 300px, (min-width: 640px) 31vw, 62vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="800">
              {% endif %}
              {% unless product.available %}
              <span class="gof-badge gof-out">Agotado</span>
              {% else %}
                {% if product.compare_at_price > product.price %}
                {% assign gof_ahorro = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="gof-badge">-{{ gof_ahorro }}%</span>
                {% endif %}
              {% endunless %}
            </div>
            <h3 class="gof-name">{{ product.title }}</h3>
            <p class="gof-price">
              <span class="gof-now">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
            </p>
          </a>
        </li>
        {% endfor %}
      </ul>
      <button type="button" class="gof-arrow gof-next" aria-label="Más productos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>

    {% if gof_boton != blank %}
    <div class="gof-foot"><a class="gof-btn" href="{{ gof_col.url }}"><span>{{ gof_boton }}</span></a></div>
    {% endif %}
  </div>
</section>

<script>
(function () {
  var sec = document.getElementById('gof');
  if (!sec || sec.dataset.listo) return;
  sec.dataset.listo = '1';
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  function rnd(a, b) { return a + Math.random() * (b - a); }

  /* contador (hora de Guatemala, según la fecha de los ajustes) */
  var cnt = document.getElementById('gof-count');
  if (cnt) {
    var fin = new Date(cnt.getAttribute('data-fin')).getTime(), u = {};
    [].forEach.call(cnt.querySelectorAll('b'), function (b) { u[b.getAttribute('data-u')] = b; });
    var tick = function () {
      var r = Math.floor((fin - Date.now()) / 1000);
      if (isNaN(r) || r <= 0) { cnt.hidden = true; return false; }
      var v = { d: Math.floor(r / 86400), h: Math.floor(r % 86400 / 3600), m: Math.floor(r % 3600 / 60), s: r % 60 };
      for (var k in v) { var t = (v[k] < 10 ? '0' : '') + v[k]; if (u[k].textContent !== t) u[k].textContent = t; }
      cnt.hidden = false;
      return true;
    };
    if (tick()) var iv = setInterval(function () { if (!tick()) clearInterval(iv); }, 1000);
  }

  /* muñeco: letrero, ojos que siguen el dedo o el mouse, y saludo al tocarlo */
  var man = sec.querySelector('.gof-man');
  if (man) {
    var eyes = man.querySelector('.gof-m-eyes'), board = man.querySelector('.gof-m-board'), t1 = man.querySelector('.gof-m-t1'), t2 = man.querySelector('.gof-m-t2');
    var msgs = (man.getAttribute('data-msgs') || '').split(';').map(function (m) { return m.split('|'); }), mi = 0, actx = null;
    var pinta = function () {
      t1.textContent = msgs[mi][0];
      t2.textContent = msgs[mi][1];
      t2.setAttribute('font-size', msgs[mi][1].length <= 5 ? 30 : msgs[mi][1].length <= 9 ? 19 : 13.5);
      t2.setAttribute('y', msgs[mi][1].length <= 5 ? 85 : 80);
    };
    pinta();
    var raf = 0, px = 0, py = 0;
    var mira = function () {
      raf = 0;
      var r = man.getBoundingClientRect(), dx = px - (r.left + r.width * .355), dy = py - (r.top + r.height * .26), d = Math.sqrt(dx * dx + dy * dy) || 1, k = Math.min(1, d / 110) * 2.4;
      eyes.style.transform = 'translate(' + (dx / d * k).toFixed(2) + 'px,' + (dy / d * k).toFixed(2) + 'px)';
    };
    if (!reduce) sec.addEventListener('pointermove', function (e) { px = e.clientX; py = e.clientY; if (!raf) raf = requestAnimationFrame(mira); }, { passive: true });
    var campanita = function () {
      try {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        actx = actx || new AC();
        if (actx.state === 'suspended') actx.resume();
        var t = actx.currentTime + .02;
        [[1568, 0], [2093, .12]].forEach(function (n) {
          var o = actx.createOscillator(), g = actx.createGain();
          o.type = 'sine'; o.frequency.value = n[0];
          g.gain.setValueAtTime(.0001, t + n[1]); g.gain.linearRampToValueAtTime(.07, t + n[1] + .005); g.gain.exponentialRampToValueAtTime(.0001, t + n[1] + .9);
          o.connect(g); g.connect(actx.destination); o.start(t + n[1]); o.stop(t + n[1] + 1);
        });
      } catch (e) {}
    };
    man.addEventListener('click', function () {
      man.classList.add('gof-tocado');
      campanita();
      // el letrero gira y cambia de mensaje
      board.classList.add('gof-flip');
      setTimeout(function () { mi = (mi + 1) % msgs.length; pinta(); board.classList.remove('gof-flip'); }, 270);
      if (reduce) return;
      man.classList.remove('gof-hi'); void man.offsetWidth; man.classList.add('gof-hi');
      setTimeout(function () { man.classList.remove('gof-hi'); }, 800);
      // nieve que salta
      if (!sec.animate) return;
      var r = man.getBoundingClientRect(), sr = sec.getBoundingClientRect(), cx = r.left - sr.left + r.width * .355, cy = r.top - sr.top + r.height * .45;
      for (var i = 0; i < 14; i++) {
        var b = document.createElement('i'), sz = rnd(5, 11), dx = rnd(-90, 90), dy = -rnd(50, 120);
        b.className = 'gof-ball';
        b.style.width = b.style.height = sz.toFixed(1) + 'px';
        sec.appendChild(b);
        b.animate([
          { transform: 'translate(' + cx + 'px,' + cy + 'px) scale(.3)', opacity: 0 },
          { transform: 'translate(' + (cx + dx * .6) + 'px,' + (cy + dy) + 'px) scale(1)', opacity: 1, offset: .4 },
          { transform: 'translate(' + (cx + dx) + 'px,' + (cy + dy + rnd(70, 130)) + 'px) scale(.6)', opacity: 0 }
        ], { duration: rnd(800, 1200), easing: 'cubic-bezier(.2,.6,.4,1)', fill: 'forwards' }).onfinish = (function (n) { return function () { n.remove(); }; })(b);
      }
    });
  }

  /* flechas */
  var track = document.getElementById('gof-track'), prev = sec.querySelector('.gof-prev'), next = sec.querySelector('.gof-next');
  function flechas() {
    prev.disabled = track.scrollLeft < 8;
    next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
  }
  function mover(dir) { track.scrollBy({ left: dir * track.clientWidth * .8, behavior: reduce ? 'auto' : 'smooth' }); }
  prev.addEventListener('click', function () { mover(-1); });
  next.addEventListener('click', function () { mover(1); });
  track.addEventListener('scroll', flechas, { passive: true });
  window.addEventListener('resize', flechas);
  flechas();

  /* serie de luces */
  (function () {
    var W = sec.clientWidth || innerWidth, chico = W < 640, n = chico ? 2 : W < 1100 ? 3 : 4, seg = W / n, sag = Math.min(seg * .075, chico ? 14 : 28), top = 2, H = top + sag + 2;
    var wire = '', bulbs = '', k = 0, bs = chico ? 7 : 9;
    var cols = [['#fff1c4', '#f2c35a', 'rgba(255,214,120,.75)'], ['#f8cdd3', '#c9485c', 'rgba(214,84,102,.6)'], ['#fff1c4', '#f2c35a', 'rgba(255,214,120,.75)'], ['#ffffff', '#efe3cd', 'rgba(255,244,220,.8)']];
    for (var i = 0; i < n; i++) {
      var x0 = i * seg, m = Math.max(4, Math.round(seg / (chico ? 30 : 44)));
      wire += 'M' + x0.toFixed(1) + ' ' + top + 'Q' + (x0 + seg / 2).toFixed(1) + ' ' + (top + 2 * sag).toFixed(1) + ' ' + (x0 + seg).toFixed(1) + ' ' + top;
      for (var j = 1; j < m; j++) {
        var t = j / m, c = cols[k % cols.length];
        bulbs += '<span class="gof-lb" style="left:' + ((x0 + seg * t) / W * 100).toFixed(2) + '%;top:' + ((top + 4 * sag * t * (1 - t)) / H * 100).toFixed(1) + '%;--bs:' + bs + 'px;--k:' + k +
          ';--c1:' + c[0] + ';--c2:' + c[1] + ';--glow:' + c[2] + ';--d:' + rnd(1.8, 3.2).toFixed(1) + 's"><i></i><b></b></span>';
        k++;
      }
    }
    sec.querySelector('.gof-lights').innerHTML = '<svg viewBox="0 0 ' + W.toFixed(0) + ' ' + H.toFixed(1) + '"><path d="' + wire + '" fill="none" stroke="#3a4766" stroke-width="1.1"/></svg>' + bulbs;
  })();

  /* nieve suave */
  if (!reduce) {
    var s = '', nf = innerWidth < 640 ? 16 : 30, alto = sec.offsetHeight + 60;
    for (var f = 0; f < nf; f++) {
      var d = rnd(10, 20);
      s += '<i style="left:' + rnd(0, 100).toFixed(1) + '%;--s:' + rnd(2.5, 7).toFixed(1) + 'px;--o:' + rnd(.35, .8).toFixed(2) + ';--d:' + d.toFixed(1) + 's;--dl:-' + rnd(0, d).toFixed(1) +
        's;--dx:' + rnd(-40, 40).toFixed(0) + 'px;--h:' + alto + 'px"></i>';
    }
    sec.querySelector('.gof-snow').innerHTML = s;
  }

  /* entrada al llegar a la sección; todo se pausa cuando no se ve */
  sec.classList.add('gof-js');
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (en) {
      var e = en[en.length - 1];
      if (e.isIntersecting && e.intersectionRatio >= .18) sec.classList.add('gof-in');
      sec.classList.toggle('gof-off', !e.isIntersecting);
    }, { threshold: [0, .18] }).observe(sec);
  } else sec.classList.add('gof-in');
})();
</script>
{% elsif request.design_mode %}
<p style="padding:24px;text-align:center;border:1px dashed #b28f7e;margin:20px">
  Ofertas navideñas: no encontré productos en la colección "{{ gof_coleccion }}". Crea esa colección o cambia el nombre en la primera línea de ajustes.
</p>
{% endif %}
