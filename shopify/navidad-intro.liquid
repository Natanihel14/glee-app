      try {
        var S = 64, c = document.createElement('canvas');
        c.width = c.height = S;
        var x = c.getContext('2d');
        x.drawImage(img, 0, 0, S, S);
        var d = x.getImageData(0, 0, S, S), p = d.data, F = T.fav;
        var br = p[0], bg = p[1], bb = p[2], ba = p[3];
        for (var i = 0; i < p.length; i += 4) {
          var a = p[i + 3] / 255;
          var k = ba < 20 ? a : Math.min(1, (Math.abs(p[i] - br) + Math.abs(p[i + 1] - bg) + Math.abs(p[i + 2] - bb)) / 140) * a;
          var y = Math.floor(i / 4 / S) / S;
          for (var ch = 0; ch < 3; ch++) {
            var fg = F.top[ch] + (F.bot[ch] - F.top[ch]) * y;
            p[i + ch] = F.bg[ch] + (fg - F.bg[ch]) * k;
          }
          p[i + 3] = ba < 20 ? k * 255 : 255;
        }
        x.putImageData(d, 0, 0);
        if (ba < 20) {
          x.globalCompositeOperation = 'destination-over';
          x.fillStyle = 'rgb(' + F.bg.join(',') + ')';
          x.beginPath(); x.arc(S / 2, S / 2, S / 2, 0, Math.PI * 2); x.fill();
          x.globalCompositeOperation = 'source-over';
        }
        F.badge(x, S);
        var url = c.toDataURL('image/png');
        [].forEach.call(links, function (l) { l.href = url; });
      } catch (e) { /* si el navegador no lo permite, se queda el ícono normal */ }
    };
    img.src = src;
  }

  /* ---------- AGREGAR AL CARRITO ---------- */
  function cartFx() {
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest(
        'button[name="add"], form[action*="/cart/add"] button[type="submit"], form[action*="/cart/add"] input[type="submit"]');
      if (!btn) return;
      playSound();
      if (reduce) return;
      var r = btn.getBoundingClientRect();
      var o = { parent: document.body, fixed: true, spread: 150, up: 210, fall: 150, min: 10, max: 20, jx: r.width * .3, jy: 4, dur: [1100, 1600], delay: 120, n: mobile ? 10 : 14 };
      if (T.cartOpts) for (var k in T.cartOpts) o[k] = T.cartOpts[k];
      var keep = T.parts;
      if (T.cartParts) T.parts = T.cartParts;
      burst(r.left + r.width / 2, r.top + r.height / 2, o.n, o);
      T.parts = keep;
    }, true);
  }

  /* ---------- CURSOR (solo compu) ---------- */
  function cursor() {
    if (reduce || !T.cursor || !window.matchMedia || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var w = T.cursor.w, b = document.createElement('div');
    b.className = P + '-cur' + cls(T.cursor.cls);
    b.innerHTML = T.cursor.svg;
    b.style.width = w + 'px';
    b.style.margin = (-w / 2) + 'px 0 0 ' + (-w / 2) + 'px';
    b.style.setProperty('--spin', T.cursor.spin || '3s');
    document.body.appendChild(b);
    var mx = -100, my = -100, x = -100, y = -100, vis = false, raf = 0, idle = 0, tilt = 0, last = 0;
    function show(v) { if (v !== vis) { vis = v; b.style.opacity = v ? '.9' : '0'; } }
    function trail() {
      var t = document.createElement('div');
      t.className = P + '-trail';
      t.innerHTML = T.trail();
      document.body.appendChild(t);
      var fx = x + rnd(-6, 6), fy = y + rnd(-4, 4);
      t.animate([
        { transform: 'translate(' + fx + 'px,' + fy + 'px) scale(1)', opacity: 1 },
        { transform: 'translate(' + (fx + rnd(-12, 12)) + 'px,' + (fy + rnd(16, 34)) + 'px) scale(.3)', opacity: 0 }
      ], { duration: 750, easing: 'ease-out', fill: 'forwards' }).onfinish = function () { t.remove(); };
    }
    function loop() {
      var dx = mx + 24 - x, dy = my + 20 - y;   // vuela un poquito al lado del cursor
      x += dx * .12; y += dy * .12;
      tilt += (Math.max(-30, Math.min(30, dx * .6)) - tilt) * .15;
      var bob = Math.sin(Date.now() / 170) * 3;
      b.style.transform = 'translate(' + x.toFixed(1) + 'px,' + (y + bob).toFixed(1) + 'px) rotate(' + tilt.toFixed(1) + 'deg)';
      var moving = Math.abs(dx) + Math.abs(dy) > 1.5;
      if (moving && T.trail && Date.now() - last > 55) { last = Date.now(); trail(); }
      if (Date.now() - idle > 1800) show(false);  // si el mouse se queda quieto, se va
      raf = (vis || moving) ? requestAnimationFrame(loop) : 0;
    }
    document.addEventListener('mousemove', function (e) {
      mx = e.clientX; my = e.clientY; idle = Date.now();
      if (x < -50) { x = mx; y = my; }
      show(true);
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    document.documentElement.addEventListener('mouseleave', function () { show(false); });
  }

  /* ---------- ARRANQUE ---------- */
  intro(false);
  onReady(function () {
    if (ES_INICIO) decorInicio();
    if (ES_PRENDA) decorPrenda();
    favicon();
    cartFx();
    cursor();
  });
  if (PREVIEW) window[P + 'Demo'] = {
    intro: function () { intro(true); }, inicio: decorInicio, prenda: decorPrenda,
    limpiar: function () { [].forEach.call(document.querySelectorAll('.' + P + '-deco'), function (n) { n.remove(); }); }
  };
})();
</script>
