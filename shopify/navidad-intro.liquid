<!-- ===== GLEE · Navidad ===== -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link id="gnv-font" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400&display=swap" rel="stylesheet">

<style>
  html.gnv-lock, html.gnv-lock body { overflow: hidden !important; }
  /* esconde widgets (Contáctanos, chats, etc.) mientras dura la intro */
  html.gnv-lock body > *:not(#gnv-intro) { visibility: hidden !important; }

  #gnv-intro {
    position: fixed; inset: 0; z-index: 2147483647;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden; transition: opacity .9s ease, visibility .9s ease;
  }
  #gnv-intro.is-out { opacity: 0; visibility: hidden; }
  #gnv-intro.is-out .gnv-logo { transform: scale(1.06); }
  .gnv-amb { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .gnv-logo {
    position: relative; z-index: 2;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-weight: 900; line-height: 1.3; letter-spacing: -.02em;
    font-size: clamp(90px, 25vw, 280px); white-space: nowrap; user-select: none;
    transition: transform .9s ease;
  }
  .gnv-logo::before {
    content: ''; position: absolute; left: 50%; top: 50%; width: 120%; height: 110%;
    transform: translate(-50%, -50%); filter: blur(30px); z-index: -1; opacity: 0;
    animation: gnvFade 1.4s ease .5s forwards, gnvPulse 2.6s ease-in-out 2s infinite;
  }
  .gnv-l {
    display: inline-block; padding: .05em .04em .3em; margin: 0 -.04em -.3em;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    opacity: 0; transform: translateY(26px) scale(.92);
    animation: gnvRise .9s cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: calc(var(--i) * .15s + .1s);
  }
  .gnv-tag {
    position: relative; z-index: 2; margin: .2em 0 0;
    font-family: 'Playfair Display', Georgia, serif; font-weight: 400;
    font-size: clamp(16px, 3.8vw, 28px);
    opacity: 0; animation: gnvFade 1s ease 1.1s forwards;
  }
  /* hasta que cargue la letra, nada se mueve (evita que el logo brinque) */
  #gnv-intro:not(.ready) .gnv-l,
  #gnv-intro:not(.ready) .gnv-tag,
  #gnv-intro:not(.ready) .gnv-logo::before { animation-play-state: paused; }

  /* partículas */
  .gnv-p { position: absolute; z-index: 3; pointer-events: none; will-change: transform, opacity; transform: translate(-50%,-50%) scale(.2); opacity: 0; }
  .gnv-p svg, .gnv-fall svg, .gnv-tw svg, .gnv-cur svg, .gnv-trail svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gnv-spin svg  { animation: gnvSpin var(--spin, 2s) linear infinite; }
  .gnv-flip svg  { animation: gnvFlip var(--spin, 1s) ease-in-out infinite alternate; }
  .gnv-swing svg { transform-origin: 50% 0; animation: gnvSwing var(--spin, 1s) ease-in-out infinite alternate; }

  /* decoración de portada y páginas */
  .gnv-deco { position: absolute; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
  .gnv-deco.gnv-page { inset: 0 0 auto 0; height: 100vh; z-index: 50; }
  .gnv-fall { position: absolute; top: -8%; width: var(--s); opacity: var(--o, 1); animation: gnvFall var(--d) linear var(--dl) infinite; }
  .gnv-tw { position: absolute; width: var(--s); opacity: 0; animation: gnvTw var(--d) ease-in-out var(--dl) infinite; }

  /* cursor */
  .gnv-cur { position: fixed; left: 0; top: 0; z-index: 2147483645; pointer-events: none; opacity: 0; transition: opacity .5s ease; will-change: transform; }
  .gnv-trail { position: fixed; left: 0; top: 0; z-index: 2147483644; pointer-events: none; }

  @keyframes gnvRise  { to { opacity: 1; transform: none; } }
  @keyframes gnvFade  { to { opacity: 1; } }
  @keyframes gnvPulse { 0%,100% { opacity: 1; } 50% { opacity: .65; } }
  @keyframes gnvSpin  { to { transform: rotate(360deg); } }
  @keyframes gnvFlip  { from { transform: scaleY(1); } to { transform: scaleY(-1); } }
  @keyframes gnvSwing { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
  @keyframes gnvFall  { from { transform: translate(0, 0) rotate(0deg); } to { transform: translate(var(--dx, 0px), 120vh) rotate(var(--r, 0deg)); } }
  @keyframes gnvTw    { 0%,100% { opacity: 0; transform: scale(.4); } 50% { opacity: var(--o, 1); transform: scale(1); } }

  /* ===== Estilo del tema ===== */
  #gnv-intro {
    background:
      radial-gradient(circle at 76% 19%, rgba(255,244,220,.17) 0%, rgba(255,244,220,0) 36%),
      linear-gradient(180deg, #0f1f36 0%, #0c182b 45%, #08111e 80%, #050a12 100%);
  }
  .gnv-logo::before { background: radial-gradient(ellipse, rgba(255,214,140,.26) 0%, rgba(255,214,140,.06) 50%, transparent 70%); }
  .gnv-l {
    position: relative;
    background-image: linear-gradient(180deg, #fff6dc 0%, #f2d589 38%, #d6a443 75%, #ad7a25 100%);
    filter: drop-shadow(0 0 14px rgba(255,210,130,.35));
  }
  .gnv-tag { font-style: italic; letter-spacing: .12em; color: #efe2c8; }

  /* luna */
  .gnv-moon {
    position: absolute; right: 12%; top: 12%; width: clamp(96px, 27vw, 210px); aspect-ratio: 1; border-radius: 50%; z-index: 0;
    background: radial-gradient(circle at 40% 38%, #fffaf0 0%, #f6ead0 55%, #e3cfa8 100%);
    box-shadow: 0 0 60px 18px rgba(255,236,200,.16), 0 0 140px 40px rgba(255,236,200,.08);
    opacity: 0; animation: gnvFade 1.2s ease .1s forwards;
  }
  .gnv-moon::after { /* manchitas suaves */
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: radial-gradient(circle at 62% 58%, rgba(200,180,150,.25) 0 12%, transparent 13%),
                radial-gradient(circle at 34% 66%, rgba(200,180,150,.18) 0 8%, transparent 9%),
                radial-gradient(circle at 58% 30%, rgba(200,180,150,.16) 0 6%, transparent 7%);
  }
  .gnv-ground { position: absolute; left: -20%; right: -20%; bottom: -14%; height: 34%; background: radial-gradient(ellipse at 50% 100%, rgba(220,232,255,.16), transparent 66%); filter: blur(14px); }

  /* trineo */
  .gnv-sleigh { position: absolute; left: 0; top: 0; z-index: 1; width: var(--sw, 300px); will-change: transform; }
  .gnv-sleigh svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gnv-spark { position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none; }
  .gnv-spark svg { display: block; width: 100%; height: auto; filter: drop-shadow(0 0 4px rgba(255,214,120,.9)); }

  /* nieve sobre las letras */
  .gnv-cap { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; filter: drop-shadow(0 1px 1.5px rgba(10,25,50,.35)); }
  .gnv-land { position: absolute; left: 0; top: 0; z-index: 3; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, #fff 0 45%, rgba(255,255,255,.6) 60%, rgba(255,255,255,0) 75%); }
  @keyframes gnvFade { to { opacity: 1; } }

  /* nieve que cae (copos suaves, con profundidad) */
  .gnv-fall b {
    display: block; width: 100%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 36%, rgba(255,255,255,.7) 52%, rgba(255,255,255,0) 72%);
    animation: gnvSway var(--sd, 3s) ease-in-out infinite alternate;
  }
  .gnv-deco .gnv-fall b { background: radial-gradient(circle, #fff 0 44%, rgba(255,255,255,.85) 56%, rgba(255,255,255,0) 74%); }
  @keyframes gnvSway { from { transform: translateX(calc(var(--sx, 10px) * -1)); } to { transform: translateX(var(--sx, 10px)); } }
  .gnv-tw svg { filter: drop-shadow(0 0 3px rgba(255,255,255,.8)); }

  /* portada: tono invernal y nieve acumulada abajo */
  .gnv-frost { position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(220,230,246,.26) 0%, rgba(220,230,246,0) 34%),
                radial-gradient(ellipse at 50% 40%, rgba(214,226,245,0) 55%, rgba(205,218,240,.22) 100%); }
  .gnv-drift { position: absolute; left: -2%; right: -2%; bottom: -1px; height: clamp(18px, 4.5vw, 46px); filter: drop-shadow(0 -2px 5px rgba(90,60,80,.2)); }
  .gnv-drift svg { display: block; width: 100%; height: 100%; }
  .gnv-deco .gnv-sleigh { z-index: 2; }
  /* ramas de pino en las esquinas */
  .gnv-pine { position: absolute; bottom: 0; width: clamp(150px, 25vw, 360px); filter: drop-shadow(0 4px 8px rgba(50,35,40,.18)); }
  .gnv-pine svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gnv-pine.l { left: 0; }
  .gnv-pine.r { right: 0; transform: scaleX(-1); }
  .gnv-star { transform-box: fill-box; transform-origin: center; animation: gnvStar 2.8s ease-in-out infinite; }
  @keyframes gnvStar { 0%, 100% { transform: scale(1); filter: none; } 50% { transform: scale(1.18); filter: drop-shadow(0 0 3px rgba(255,214,120,.95)); } }
  .gnv-deco .gnv-spark svg { filter: drop-shadow(0 0 3px rgba(217,173,79,.9)); }

  .gnv-ice svg { filter: drop-shadow(0 0 2px rgba(60,90,130,.55)); }

  @media (prefers-reduced-motion: reduce) {
    .gnv-l { animation: gnvFade .4s ease forwards !important; transform: none; }
    .gnv-deco *, .gnv-amb * { animation: none !important; }
    .gnv-fall, .gnv-tw { display: none; }
  }
</style>

<script>
(function () {
  // ===== Ajustes =====
  var FECHA_INICIO = new Date('2026-12-01T00:00:00-06:00'); // a partir de aquí se muestra
  var FECHA_FIN    = new Date('2026-12-26T00:00:00-06:00');   // a partir de aquí ya no se muestra
  var DURACION_MS  = 3200;                  // cuánto dura la intro
  var UNA_VEZ_POR_SESION = true;            // la intro sale una vez por visita
  var VOLUMEN = 0.35;                       // sonido al agregar al carrito (0 = sin sonido)

  var P = 'gnv';
  var ES_INICIO  = {% if template.name == 'index' %}true{% else %}false{% endif %};
  var ES_PRENDA  = {% if template.name == 'product' or template.name == 'collection' %}true{% else %}false{% endif %};
  var ES_CARRITO = {% if template.name == 'cart' %}true{% else %}false{% endif %};
  var PREVIEW = false;

  var hoy = new Date();
  if (!PREVIEW && (hoy < FECHA_INICIO || hoy >= FECHA_FIN)) return;

  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var mobile = window.innerWidth < 640;
  function rnd(a, b) { return a + Math.random() * (b - a); }
  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
  function cls(c) { return c ? ' ' + c.split(' ').map(function (k) { return P + '-' + k; }).join(' ') : ''; }
  function onReady(fn) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn); else fn(); }

  /* capas: cosas que caen y destellos */
  function fallers(n, inner, o) {
    var h = '';
    for (var i = 0; i < n; i++) {
      var it = inner(i);
      h += '<i class="' + P + '-fall' + cls(it.cls) + '" style="left:' + rnd(-2, 100).toFixed(1) + '%;--s:' + rnd(o.min, o.max).toFixed(1) +
        'px;--d:' + rnd(o.dmin, o.dmax).toFixed(1) + 's;--dl:-' + rnd(0, o.dmax).toFixed(1) + 's;--dx:' + rnd(-o.drift, o.drift).toFixed(0) +
        'px;--r:' + rnd(-o.rot, o.rot).toFixed(0) + 'deg;--o:' + rnd(o.omin, o.omax).toFixed(2) + ';--spin:' + rnd(.8, 2).toFixed(2) + 's">' + it.html + '</i>';
    }
    return h;
  }
  function twinkles(n, svg, o) {
    var h = '';
    for (var i = 0; i < n; i++) {
      h += '<i class="' + P + '-tw' + cls(o.cls) + '" style="left:' + rnd(o.x0, o.x1).toFixed(1) + '%;top:' + rnd(o.y0, o.y1).toFixed(1) +
        '%;--s:' + rnd(o.min, o.max).toFixed(1) + 'px;--d:' + rnd(1.6, 3.2).toFixed(1) + 's;--dl:-' + rnd(0, 3).toFixed(1) + 's;--o:' + rnd(.6, 1).toFixed(2) + '">' + svg + '</i>';
    }
    return h;
  }

  /* sonido (hecho con código, sin archivos) */
  var actx = null, nbuf = null;
  function audio() {
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC || VOLUMEN <= 0) return null;
    actx = actx || new AC();
    if (actx.state === 'suspended') actx.resume();
    if (!nbuf) {
      nbuf = actx.createBuffer(1, actx.sampleRate, actx.sampleRate);
      var d = nbuf.getChannelData(0);
      for (var i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    }
    return actx;
  }
  function noiseHit(t, dur, freq, q, amp) {
    var s = actx.createBufferSource(); s.buffer = nbuf;
    var f = actx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = q;
    var g = actx.createGain();
    g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(amp, t + 0.004); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    s.connect(f); f.connect(g); g.connect(actx.destination);
    s.start(t, Math.random() * 0.5); s.stop(t + dur + 0.02);
  }
  function bell(t, freq, amp, decay, partials) {
    (partials || [[1, 1], [2.76, .45], [5.4, .2]]).forEach(function (p) {
      var o = actx.createOscillator(); o.type = 'sine'; o.frequency.value = freq * p[0];
      var g = actx.createGain(), dd = decay / Math.sqrt(p[0]);
      g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(amp * p[1], t + 0.005); g.gain.exponentialRampToValueAtTime(0.0001, t + dd);
      o.connect(g); g.connect(actx.destination); o.start(t); o.stop(t + dd + 0.05);
    });
  }
  function playSound() { try { if (!audio()) return; T.sound(actx.currentTime + 0.02, VOLUMEN); } catch (e) {} }

  var T = {};
  /* ===== Tema ===== */
  function FLAKE(c) {
    var g = '';
    for (var a = 0; a < 360; a += 60) g += '<path transform="rotate(' + a + ')" d="M0 0V-10M0-6.2-3-8.6M0-6.2 3-8.6M0-3-2-4.6M0-3 2-4.6"/>';
    return '<svg viewBox="-12 -12 24 24"><g stroke="' + c + '" stroke-width="1.6" stroke-linecap="round" fill="none">' + g + '</g></svg>';
  }
  function SPARK(c) { return '<svg viewBox="0 0 24 24"><path d="M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z" fill="' + c + '"/></svg>'; }
  var STARW = SPARK('#fff');

  /* ---------- Trineo de Santa (silueta animada) ---------- */
  // movimiento suave de ida y vuelta (SMIL: funciona en Chrome, Safari y Firefox)
  function anim(type, vals, dur, begin) {
    var v = vals.split(';'), kt = [], ks = [];
    for (var i = 0; i < v.length; i++) { kt.push((i / (v.length - 1)).toFixed(3)); if (i) ks.push('.45 0 .55 1'); }
    return '<animateTransform attributeName="transform" type="' + type + '" values="' + vals + '" keyTimes="' + kt.join(';') +
      '" calcMode="spline" keySplines="' + ks.join(';') + '" dur="' + dur + 's" begin="-' + begin + 's" repeatCount="indefinite"/>';
  }
  function DEER(x, y, ph) {
    var g = '.44';
    return '<g transform="translate(' + x + ' ' + y + ')"><g>' + anim('translate', '0 0;0 -1.8;0 0', g, '0') +
      '<path d="M8 27Q10 21 22 21Q31 21 36 22Q41 23 41 28Q40 33 33 34Q22 35 13 33Q7 31 8 27Z"/>' +
      '<path d="M9 24Q4 20 2 22Q4 25 9 27Z"/>' +
      // cuello, cabeza y astas: cabecean al correr
      '<g>' + anim('rotate', '-4 38 26;5 38 26;-4 38 26', g, ph) +
        '<path d="M35 25Q39 17 44 11L49 13Q45 21 41 29Z"/><path d="M43 9Q47 7 51 9Q55 11 58 13Q58 15 55 15Q50 15 45 14Q42 12 43 9Z"/><path d="M45 9L41 6L44 11Z"/>' +
        '<g fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M46 8Q43 2 44-5M44.2 1Q40.5 0 38.5-3.5M44-2Q46-4 47-7"/><path d="M48 8Q49 2 53-3M50.6 2.2Q53.5 1.6 55.5-.6M52-1Q51-4 51.5-6"/></g>' +
      '</g>' +
      // patas: galope (delanteras y traseras en tiempos opuestos)
      '<g fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' +
        '<g>' + anim('rotate', '-34 36 31;20 36 31;-34 36 31', g, ph) + '<path d="M37 31Q42 35 45 40L50 39.5"/></g>' +
        '<g>' + anim('rotate', '-30 35 32;24 35 32;-30 35 32', g, (+ph + .06).toFixed(2)) + '<path d="M34 32Q37 38 39 43L44 44"/></g>' +
        '<g>' + anim('rotate', '26 14 31;-26 14 31;26 14 31', g, ph) + '<path d="M13 31Q8 35 3 35.5L-1.5 33.5"/></g>' +
        '<g>' + anim('rotate', '22 16 32;-30 16 32;22 16 32', g, (+ph + .06).toFixed(2)) + '<path d="M16 32Q12 38 7 41L2.5 41"/></g>' +
      '</g></g></g>';
  }
  function SLEIGH(c) {
    return '<svg viewBox="-2 -12 406 124"><g fill="' + c + '" stroke="' + c + '">' +
      '<g>' +
        '<path stroke="none" d="M6 72Q3 92 17 95L80 95Q96 95 99 81Q100 72 92 71Q86 71 86 77Q85 85 76 86L33 86Q28 86 28 79L28 66Q28 58 19 58Q11 58 9 64Q6 66 6 72Z"/>' +
        '<path d="M9 64Q4 56 10 53Q15 52 15 57" fill="none" stroke-width="2.4" stroke-linecap="round"/>' +
        '<path d="M1 104Q50 110 93 103Q105 100 103 91Q101 85 96 88Q93 91 97 93" fill="none" stroke-width="2.6" stroke-linecap="round"/>' +
        '<path d="M22 95L22 105M66 95L66 105" stroke-width="2.6" stroke-linecap="round"/>' +
        '<path stroke="none" d="M13 62Q9 44 21 38Q28 35 33 42Q37 50 33 62Z"/>' +
        '<path stroke="none" d="M35 86Q32 66 43 60Q51 57 58 62Q63 68 63 86Z"/><circle stroke="none" cx="51" cy="53" r="6.2"/>' +
        '<path stroke="none" d="M50 56Q56 56 59 59Q58 66 52 66Q49 62 50 56Z"/><path stroke="none" d="M44.5 50Q46 42 54 43Q58 44 58 50Z"/>' +
        // punta del gorro ondeando
        '<g>' + anim('rotate', '0 46 46;-14 46 46;0 46 46', '.7', '0') + '<path stroke="none" d="M47 44Q41 40 36 45Q38 46 40 45Q43 44 46 47Z"/><circle stroke="none" cx="35.5" cy="46" r="2.6"/></g>' +
        // brazo sacudiendo las riendas
        '<g>' + anim('rotate', '4 57 68;-10 57 68;4 57 68', '.44', '0') +
          '<path d="M57 69Q66 66 75 64" fill="none" stroke-width="3" stroke-linecap="round"/></g>' +
        '<path fill="none" stroke-width="1" d="M75.24 65.27Q100 73 122 73"><animate attributeName="d" values="M75.24 65.27Q100 73 122 73;M74.03 60.94Q100 70 122 71.2;M75.24 65.27Q100 73 122 73" keyTimes="0;.5;1" calcMode="spline" keySplines=".45 0 .55 1;.45 0 .55 1" dur=".44s" repeatCount="indefinite"/></path>' +
      '</g>' +
      '<g>' + anim('translate', '0 0;0 -1.8;0 0', '.44', '0') + '<path d="M150 74L188 61M216 62L254 49M282 50L320 37" fill="none" stroke-width="1"/></g>' +
      DEER(112, 46, '0') + DEER(178, 34, '.11') + DEER(244, 22, '.22') + DEER(310, 10, '.33') +
      '</g></svg>';
  }
  function sleighEl(w, color) {
    var d = document.createElement('div');
    d.className = 'gnv-sleigh';
    d.style.setProperty('--sw', w + 'px');
    d.style.opacity = 0;
    d.innerHTML = SLEIGH(color);
    return d;
  }
  // vuelo en curva: sale de P0, pasa por M y sale por P2 (coordenadas dentro de "box")
  function fly(box, sl, P0, M, P2, dur, o, cb) {
    var sw = sl.offsetWidth, sh = sl.offsetHeight, t0 = .58, u = 1 - t0;
    var P1 = [(M[0] - u * u * P0[0] - t0 * t0 * P2[0]) / (2 * u * t0), (M[1] - u * u * P0[1] - t0 * t0 * P2[1]) / (2 * u * t0)];
    var st = 0, last = 0;
    function bz(t, i) { var v = 1 - t; return v * v * P0[i] + 2 * v * t * P1[i] + t * t * P2[i]; }
    function frame(now) {
      if (o.stop && o.stop()) return;
      if (!st) st = now;
      var t = Math.min(1, (now - st) / dur), x = bz(t, 0), y = bz(t, 1) + Math.sin(now / 260) * sh * .06;
      var dx = 2 * (1 - t) * (P1[0] - P0[0]) + 2 * t * (P2[0] - P1[0]), dy = 2 * (1 - t) * (P1[1] - P0[1]) + 2 * t * (P2[1] - P1[1]);
      var ang = Math.atan2(dy, dx);
      sl.style.opacity = 1;
      sl.style.transform = 'translate(' + (x - sw / 2).toFixed(1) + 'px,' + (y - sh / 2).toFixed(1) + 'px) rotate(' + (ang * 180 / Math.PI + 7).toFixed(1) + 'deg)';
      if (now - last > o.every && document.body.animate) {
        last = now;
        // destellos que salen de los patines
        var bx = x - Math.cos(ang) * sw * .42 + Math.sin(ang) * sh * .3, by = y - Math.sin(ang) * sw * .42 + Math.cos(ang) * sh * .3;
        var s = document.createElement('div'), sz = rnd(o.spark[0], o.spark[1]);
        s.className = 'gnv-spark';
        s.style.width = sz.toFixed(1) + 'px';
        s.innerHTML = Math.random() < .7 ? SPARK(o.color) : '<b style="display:block;width:100%;aspect-ratio:1;border-radius:50%;background:' + o.color + '"></b>';
        box.appendChild(s);
        var ox = bx + rnd(-6, 6), oy = by + rnd(-4, 4);
        s.animate([
          { transform: 'translate(' + ox + 'px,' + oy + 'px) scale(1)', opacity: 1 },
